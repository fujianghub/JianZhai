# Caddyfile — production reverse-proxy + HTTPS.
#
# Caddy auto-provisions a Let's Encrypt cert for the domain below the
# first time it receives a request.  The cert lives in the ``caddy_data``
# volume so it survives container restarts.
#
# IMPORTANT: replace ``fujiang.jianzhai.cn`` with your real ICP-备案'd
# domain before deploying.  If you haven't filed yet, comment out the
# domain block and use the ``:80`` fallback below so you can test
# locally while waiting for 管局.

{
    # Global options.  ``email`` is used by Let's Encrypt for expiry
    # notifications — put a mailbox you actually read.
    email fujiangfeng28@gmail.com
}

# ─── Main site ───────────────────────────────────────────────────────
fujiang.jianzhai.cn {
    # Reverse-proxy Django API.  ``backend`` is the docker-compose
    # service name; docker's internal DNS resolves it.
    @api {
        path /api/* /feed.xml /sitemap.xml /robots.txt
    }
    handle @api {
        reverse_proxy backend:8002 {
            # Stream SSE without buffering — required for /ai/stream/
            # and /ai/chat/ to deliver tokens in real time.
            flush_interval -1
            # 2-min read timeout — AI calls can take a while.
            transport http {
                read_timeout 120s
                response_header_timeout 120s
            }
        }
    }

    # Django admin (Django's built-in /admin/) — kept reachable so
    # the operator can poke models directly.
    handle /django-admin/* {
        reverse_proxy backend:8002
    }

    # Static files served by WhiteNoise inside Django.
    handle /static/* {
        reverse_proxy backend:8002
    }

    # User-uploaded media (avatars, attachments, etc).  Served straight
    # from the shared ``media_data`` volume (mounted read-only at
    # /srv-media in docker-compose.prod.yml) — Django's dev-only
    # ``static()`` URL helper is disabled when DEBUG=False, so proxying
    # /media/* to the backend would just 404.
    handle_path /media/* {
        # Byte-layer gate (2026-09-08): every media request is checked by the
        # backend first (session cookie is forwarded), so audience / ReadGrant /
        # SITE_REQUIRE_LOGIN apply to the files, not just the API. Decisions are
        # cached 60 s per user+path server-side; the browser cache below keeps
        # repeat views from hitting the backend at all.
        forward_auth backend:8002 {
            uri /api/v1/media-auth/
            # handle_path already stripped /media, and forward_auth's default
            # X-Forwarded-Uri is the *rewritten* URI — send the original one so
            # the backend sees /media/<relpath> (else it 404s everything).
            header_up X-Forwarded-Uri {http.request.orig_uri}
        }
        # Standalone SVG / HTML attachments navigated directly (new tab,
        # ``<iframe src>`` fallback) run in an opaque origin: scripts may run
        # but cannot touch cookies / the SPA. NOTE: path-level headers only win
        # because the site-level block below uses ``?`` (set-if-absent) — an
        # unconditional site-level set is deferred (``-Server`` in the same
        # block) and would overwrite these at write time (verified with a
        # local caddy, 2026-09-23; that is what silently disabled the SVG
        # sandbox before).
        @svg path *.svg
        header @svg Content-Security-Policy "sandbox"
        @html path *.html *.htm
        header @html Content-Security-Policy "sandbox allow-scripts allow-popups allow-forms"
        # Office/archive uploads download instead of rendering same-origin;
        # PDF stays inline (the "在新标签打开" native viewer relies on it).
        @office path *.docx *.pptx *.ppt *.doc *.zip
        header @office Content-Disposition attachment
        # uuid-named, never rewritten in place → cache forever, but *private*:
        # the gate above makes the response user-specific.
        @immutable path /uploads/* /slides/* /derived/*
        header @immutable Cache-Control "private, max-age=31536000, immutable"
        @avatars path /avatars/*
        header @avatars Cache-Control "public, max-age=300"
        root * /srv-media
        file_server
    }

    # Self-hosted draw.io (简斋 画板 — infra/drawio/build.py output, mounted
    # read-only at /srv-drawio). Same origin, so the SPA embeds it as a plain
    # <iframe src="/drawio/index.html?embed=1&proto=json…"> and talks to it via
    # postMessage. Runs under the site-level CSP unchanged (index.html has no
    # inline script; mxGraph's eval paths are behind allowEval=false — verified
    # with Playwright, zero violations). Files are not content-hashed, so cache
    # for an hour with ETag revalidation rather than immutable.
    handle_path /drawio/* {
        root * /srv-drawio
        header Cache-Control "public, max-age=3600"
        file_server
    }

    # HTML sandbox host page (frontend/public/embed/): HtmlPostReader and the
    # HTML editor previews load it via <iframe src> (never srcdoc — a srcdoc
    # document inherits the parent's CSP and the site-level ``script-src
    # 'self'`` would block the injected height-report bootstrap and every
    # author inline script). The page gets its own relaxed policy: sandboxed
    # (opaque origin, no cookies / parent DOM) but scripts allowed. The iframe
    # element's ``sandbox`` attribute applies on top of this.
    handle /embed/* {
        header Content-Security-Policy "sandbox allow-scripts allow-popups allow-forms; frame-ancestors 'self'"
        root * /srv
        file_server
    }

    # SPA fallback — anything else hits the React build.  ``try_files``
    # serves real files when they exist (assets/*.js), otherwise
    # falls back to index.html so the SPA router can take over.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    # Gzip + zstd compression for text-y responses.
    encode zstd gzip

    # Security headers.
    header {
        # Scripts only from this origin. The SPA build has no inline scripts
        # (index.html is a single module tag); 'wasm-unsafe-eval' keeps
        # pdf.js's WebAssembly decoders working. This is also the EPUB
        # reader's real defence: chapters render in blob: iframes, which
        # inherit this policy, and iframe sandbox cannot block their scripts
        # (WebKit bug 218086) — the backend strips them at upload, CSP is
        # the backstop. Verified against the built bundle with Playwright
        # (EPUB / PDF / mermaid+KaTeX posts / home / admin, 2026-09-01).
        # ``?`` = set only if absent, so the path-level policies above
        # (/media/*.svg, /media/*.html, /embed/*) win. Without ``?`` this whole
        # block is deferred (because of ``-Server``) and overwrites them.
        ?Content-Security-Policy "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; worker-src 'self' blob:"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions-Policy explicitly disables features we don't use.
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        # HSTS is sent by Django (settings.py enables SECURE_HSTS_SECONDS
        # whenever the public origin is https), so it's not duplicated here.
        # If you ever serve static files without proxying Django, uncomment:
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Log access to docker-compose's stdout for ``docker compose logs caddy``.
    log {
        output stdout
        format console
        level INFO
    }
}

# ─── HTTP-only fallback ──────────────────────────────────────────────
#
# Useful before ICP 备案 finishes — point your local hosts file to the
# server IP and access via http://<ip>:80 for smoke-testing.
# Uncomment the block when needed; comment out the domain block above.
#
# :80 {
#     handle /api/* { reverse_proxy backend:8002 }
#     handle /media/* { reverse_proxy backend:8002 }
#     handle /static/* { reverse_proxy backend:8002 }
#     handle { root * /srv; try_files {path} /index.html; file_server }
# }
